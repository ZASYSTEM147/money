rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // One document per tracker. "members" is the list of Gmail addresses allowed to open it.
    match /trackers/{id} {
      allow create: if request.auth != null
        && request.auth.token.email_verified == true
        && request.resource.data.owner == request.auth.uid
        && request.auth.token.email in request.resource.data.members;

      allow read: if request.auth != null
        && request.auth.token.email in resource.data.members;

      // Members can save data. Only the owner can change who is a member.
      allow update: if request.auth != null
        && request.auth.token.email in resource.data.members
        && request.resource.data.owner == resource.data.owner
        && (request.resource.data.members == resource.data.members
            || request.auth.uid == resource.data.owner);

      allow delete: if request.auth != null && request.auth.uid == resource.data.owner;
    }
  }
}
